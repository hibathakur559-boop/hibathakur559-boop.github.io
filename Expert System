        "                'diagnosis': 'Worn CV Joints',\n",
        "                'confidence': 0.84,\n",
        "                'action': 'Inspect CV joints and boots. Replace if damaged.',\n",
        "                'urgency': 'Medium'\n",
        "            },\n",
        "            {\n",
